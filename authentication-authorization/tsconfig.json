{
  "compilerOptions": {
    /* Target Environment */
    "target": "ES2022" /* Output modern, optimized JavaScript */,
    "module": "NodeNext" /* Match Node.js module resolution system */,
    "moduleResolution": "NodeNext" /* Correctly handle node_modules & file extensions */,

    /* Directories */
    "rootDir": "./src" /* Locate your TypeScript source code */,
    "outDir": "./dist" /* Direct compiled JS output files here */,

    /* Type Checking & Safety */
    "strict": true /* Enable all strict type-checking choices */,
    "noImplicitAny": true /* Error on expressions with an implied 'any' type */,
    "strictNullChecks": true /* Defend your code against null/undefined bugs */,

    /* Interoperability & Speed */
    "esModuleInterop": true /* Smoothly import CommonJS modules as ES modules */,
    "forceConsistentCasingInFileNames": true /* Enforce exact casing for cross-platform safety */,
    "skipLibCheck": true /* Skip type checking of declaration files for faster builds */,
    "resolveJsonModule": true /* Enable importing .json files directly */,
    "sourceMap": true /* Generate source maps for easier production debugging */,

    "types": ["node"]
  },
  "include": ["src/**/*"] /* Compile all files inside the source folder */,
  "exclude": [
    "node_modules",
    "dist"
  ] /* Never check third-party or compiled folders */
}
